# Légifrance API (PISTE) credentials
# Register at https://piste.gouv.fr
PISTE_CLIENT_ID=your_client_id
PISTE_CLIENT_SECRET=your_client_secret
PISTE_SANDBOX=true  # Set to false for production

# Database connection
# SQLite for dev, PostgreSQL for prod
DATABASE_URL=sqlite:///data/legislateur.db

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Provider: "local" (free, uses sentence-transformers) or "openai" (paid API)
EMBEDDING_PROVIDER=local

# Local embeddings (when EMBEDDING_PROVIDER=local)
# sentence-transformers model options:
#
# Model                                         | Dim  | Speed   | Quality | Notes
# ----------------------------------------------|------|---------|---------|----------------------------------
# paraphrase-multilingual-MiniLM-L12-v2         | 384  | Fast    | Good    | Default. Best speed/quality for CPU
# Lajavaness/sentence-camembert-large           | 1024 | Medium  | Great   | Top French sentence embeddings
# OrdalieTech/Solon-embeddings-large-0.1        | 1024 | Slow    | Great   | French legal domain, best for legal text
# BAAI/bge-m3                                   | 1024 | Slow    | Great   | Hybrid dense+sparse+ColBERT, multilingual
# distiluse-base-multilingual-cased-v2          | 512  | Fast    | Fair    | Lightweight alternative
#
# IMPORTANT: Changing the model requires regenerating all embeddings (--embed phase).
# The 1024-dim models (CamemBERT, Solon, BGE-M3) need GPU for reasonable speed.
# BGE-M3 can also produce sparse vectors natively (used by BM25 integration if available).
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# OpenAI embeddings (when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# LLM CONFIGURATION (Intent Extraction)
# =============================================================================
# Provider: "groq" (free tier available) or "anthropic" (paid API)
LLM_PROVIDER=groq

# Groq API (when LLM_PROVIDER=groq)
# Get a free API key at https://console.groq.com/
# Multiple keys supported for automatic rotation on rate limits
# Each free tier key has 100K tokens/day limit
#
# Option 1 (recommended): Comma-separated list of keys
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
#
# Option 2 (legacy): Single key fallback
GROQ_API_KEY=your_groq_api_key
#
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic API (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# EXTRACTION PROVIDER (Article Analysis)
# =============================================================================
# Provider: "llm" (default, uses Groq/Anthropic) or "langextract" (source-grounded)
EXTRACTION_PROVIDER=llm

# LangExtract settings (when EXTRACTION_PROVIDER=langextract)
# Uses Google Gemini for source-grounded extraction with exact citations
# Get an API key at https://aistudio.google.com/apikey
LANGEXTRACT_API_KEY=your_google_ai_api_key
LANGEXTRACT_MODEL=gemini-2.5-flash

# Optional: Set to "production" for PostgreSQL
ENVIRONMENT=development
